{
  "name": "wafixer-sdk",
  "version": "0.2.0",
  "description": "Official WAFixer TypeScript SDK — WhatsApp, Messenger and Instagram messaging, Facebook/Instagram comments, Facebook Lead Ads and typed webhook events.",
  "keywords": [
    "wafixer",
    "whatsapp",
    "messenger",
    "instagram",
    "facebook",
    "lead-ads",
    "comments",
    "baileys",
    "messaging",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/mirac46/wafixer-packages#readme",
  "bugs": {
    "url": "https://github.com/mirac46/wafixer-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirac46/wafixer-packages.git",
    "directory": "packages/wafixer-sdk"
  },
  "license": "MIT",
  "author": "mirac46",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "generate:types": "node scripts/generate-types.mjs",
    "prepublishOnly": "npm run clean && npm run test && npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
